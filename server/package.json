{
  "name": "primeclass-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend skeleton for PrimeClass",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "db:bootstrap": "node ./scripts/bootstrap-local-db.mjs",
    "smoke": "node ./scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.4.0",
    "basic-ftp": "^5.2.0",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
